{
  "name": "stipra",
  "version": "0.1.0",
  "private": true,
  "description": "Stiprā — a programmable printmaking studio (Latvian strength; stippling + strata)",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stipra": "bin/stipra.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "presets": "node bin/stipra.js presets",
    "render:prehnite": "node bin/stipra.js render --preset 01 --format png,svg --plates --out out",
    "check": "node --check src/core.js && node --check src/import/svg.js && node --check src/import/probe.js && node --check src/import/asset.js && node --check src/import/node.js && node --check bin/import.js && node --check examples/import-studio/app.js && node --check bin/scene.js && node --check bin/stipra.js && npm test",
    "build:pages": "npm run prepare:fonts && node scripts/build-pages.js && node scripts/build-type-specimens.js dist/stipra && node scripts/build-identity-study.js dist/stipra/identity",
    "check:packages": "node --test tests/print-package.test.js",
    "build:mark": "node scripts/generate-stipra-mark.js",
    "build:type-proofs": "node scripts/build-type-specimens.js dist/stipra",
    "prepare:paper-mono": "node scripts/cache-paper-mono.js",
    "build:identity": "node scripts/build-identity-study.js dist/stipra/identity",
    "build:github-pages": "npm run build:pages && node scripts/build-github-pages.js",
    "audit:licenses": "node scripts/license-audit.js",
    "check:release-licenses": "node scripts/license-audit.js --release-check",
    "build:core": "node scripts/build-core.js",
    "check:core-package": "node --test tests/core-package.test.js",
    "build:sketches": "node scripts/build-sketches.js",
    "benchmark:alpha": "node scripts/benchmark-alpha.js",
    "check:alpha": "STIPRA_SMOKE_PAGE=examples/alpha/browser-smoke.html STIPRA_SMOKE_EXPECT=BROWSER_ALPHA_PASS node scripts/browser-smoke.js && node scripts/verify-alpha-parity.js",
    "build:inputs": "node scripts/build-inputs.js",
    "check:provenance": "node scripts/check-provenance.js",
    "check:regions": "STIPRA_SMOKE_PAGE=examples/regions/browser-smoke.html STIPRA_SMOKE_EXPECT=BROWSER_REGIONS_PASS node scripts/browser-smoke.js && node scripts/verify-region-parity.js",
    "check:distribution": "node scripts/check-distribution.js",
    "check:exports": "node scripts/verify-export-workflow.js",
    "check:export-parity": "STIPRA_SMOKE_PAGE=examples/export-validation/browser-smoke.html STIPRA_SMOKE_EXPECT=BROWSER_EXPORTS_PASS node scripts/browser-smoke.js && node scripts/verify-browser-exports.js",
    "check:goldens": "node scripts/acceptance-goldens.js",
    "check:library-candidate": "node scripts/check-library-candidate.js",
    "check:print-observations": "node scripts/check-print-observations.js",
    "prepare:fonts": "node scripts/cache-paper-mono.js",
    "check:browser-distribution": "node scripts/build-browser-export.js out/browser-distribution/export.mjs",
    "check:accessibility": "STIPRA_SMOKE_PAGE=examples/accessibility/browser-smoke.html STIPRA_SMOKE_EXPECT=BROWSER_ACCESSIBILITY_PASS node scripts/browser-smoke.js",
    "check:roadmap-visual": "node scripts/verify-roadmap-css-visual.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@noble/hashes": "1.8.0",
    "@xmldom/xmldom": "0.9.12",
    "buffer": "6.0.3",
    "fontkit": "2.0.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "skia-canvas": "^3.0.8"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "esbuild": "0.25.12",
    "p5": "1.11.11",
    "p5-v2": "npm:p5@2.2.2",
    "typescript": "5.9.3"
  }
}
